{
  "name": "learnbash",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "license": "UNLICENSED",
  "scripts": {
    "build:image": "sh image/build.sh",
    "build:state": "node scripts/build-state.ts",
    "build:vm": "npm run build:image && npm run build:state",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "sh scripts/shellcheck.sh",
    "stage:vm": "node scripts/stage-vm-assets.ts",
    "dev": "npm run stage:vm && vite --open /challenges/look-around/",
    "build": "npm run stage:vm && vite build",
    "check:content": "node scripts/check-content.ts",
    "todo-review": "node scripts/check-content.ts --todo",
    "test:e2e": "npm run build && playwright test"
  },
  "dependencies": {
    "@xterm/addon-fit": "0.11.0",
    "@xterm/xterm": "6.0.0",
    "marked": "18.0.14",
    "v86": "0.5.469",
    "yaml": "2.9.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/node": "24.9.1",
    "typescript": "7.0.2",
    "vite": "8.3.4",
    "vitest": "5.0.3"
  }
}
